.dlg .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:14px}
.dlg ol{text-align:left;padding-left:20px}
.btn.dark{background:var(--acc);color:var(--accfg);box-shadow:none}
.btn.danger{background:#b3261e;color:#fff;box-shadow:none}
/* cert */
.cert{background:#fbf5e6;color:#13223e;border:10px double #b8860b;border-radius:6px;padding:clamp(22px,5vw,56px);text-align:center;position:relative;max-width:900px;margin:0 auto;box-shadow:var(--shadow)}
.cert::before{content:"";position:absolute;inset:8px;border:1.5px solid rgba(184,134,11,.5);pointer-events:none}
