<script>
(function(){
'use strict';
/* ---------- helpers ---------- */
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const KEY='jk-digital-passport-v1';
let storageOK=true;
const blank=()=>({name:'',pass:'',started:'',seen:{},stamps:{},quizBest:null,ans:{},certNo:'',certDate:''});
function load(){try{localStorage.setItem(KEY+'-t','1');localStorage.removeItem(KEY+'-t');const r=localStorage.getItem(KEY);if(r)return Object.assign(blank(),JSON.parse(r));}catch(e){storageOK=false}return blank();}
let S=load();
function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){storageOK=false}}
const ui={open:{},tab:{culture:'food',geo:'mount'},saf:0,pin:null,m:{rain:2,veg:false,drain:false,ews:false,map:false,used:false},quiz:{i:0,sel:null,score:0,done:false},draft:{saf:{choice:null,reason:''},ch:{choice:null,reason:''}},modal:null,queue:[],route:null,timer:null,playing:false};
const cnt=p=>Object.keys(S.seen).filter(k=>k.indexOf(p)===0).length;
const today=()=>new Date().toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'});

/* ---------- art (original inline illustrations) ---------- */
const sky=(id,a,b,inner)=>`<defs><linearGradient id="g${id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${a}"/><stop offset="1" stop-color="${b}"/></linearGradient></defs><rect width="400" height="260" fill="url(#g${id})"/>${inner}`;
const peaks=(c1,c2,snow=true)=>`<path d="M0 175 L70 95 L120 145 L185 70 L255 150 L310 105 L400 175 V260 H0Z" fill="${c1}"/>${snow?'<path d="M185 70 L165 98 L180 92 L190 102 L200 90 L212 98Z M70 95 L56 114 L68 108 L78 116Z M310 105 L296 124 L308 118 L318 126Z" fill="#fff" opacity=".9"/>':''}<path d="M0 205 L60 150 L120 195 L190 140 L260 200 L330 150 L400 200 V260 H0Z" fill="${c2}"/>`;
const pine=(x,y,s=1,c='#1f4d3a')=>`<path d="M${x} ${y} l${-10*s} ${28*s} h${20*s}z M${x} ${y+14*s} l${-13*s} ${30*s} h${26*s}z" fill="${c}"/><rect x="${x-1.5*s}" y="${y+44*s}" width="${3*s}" height="${8*s}" fill="#3b2a1a"/>`;
const sun=(x,y,r,c='#ffd27a')=>`<circle cx="${x}" cy="${y}" r="${r}" fill="${c}" opacity=".92"/>`;
const water=(y=195)=>`<rect y="${y}" width="400" height="${260-y}" fill="#27698c"/><path d="M20 ${y+14}h60M120 ${y+26}h80M250 ${y+18}h90M60 ${y+44}h100M230 ${y+50}h110" stroke="#9fd2ea" stroke-width="2" opacity=".55"/>`;
const boat=(x,y,c='#d34a3a')=>`<g transform="translate(${x} ${y})"><path d="M0 14 q50 14 120 0 l-14 10 q-45 8 -92 0z" fill="${c}"/><path d="M26 14 v-14 h60 v14z" fill="#f6efe0"/><path d="M20 0 h72 l-8 -9 h-56z" fill="#e0a21b"/></g>`;
