.chain{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.chain span{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:8px 12px;font-weight:600;font-size:.9rem}.chain i{color:var(--gold);font-style:normal}
@media(max-width:600px){.meters{grid-template-columns:1fr}.hero{min-height:calc(100svh - 90px)}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}
