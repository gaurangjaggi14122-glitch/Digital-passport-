footer{margin-top:40px;background:var(--mid);color:#cfdcec;padding:30px 0 40px;font-size:.88rem}
.next{display:flex;justify-content:flex-end;padding:20px 0 0}
.src li{margin:6px 0}
.src a{color:var(--gold);word-break:break-all}
.lg{display:flex;gap:14px;flex-wrap:wrap;font-size:.85rem;margin-top:8px}.lg i{display:inline-block;width:14px;height:14px;border-radius:4px;margin-right:6px;vertical-align:-2px}
